# ─── Evolution API Configuration ─────────────────────────────────────────────
# Used for WhatsApp automation via Evolution API
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Evolution API Server URL (your self-hosted or cloud Evolution instance)
NEXT_PUBLIC_EVOLUTION_URL=https://evo.campushub.co.ke

# Evolution API Global API Key (for creating/managing instances)
NEXT_PUBLIC_EVOLUTION_API_KEY=your-evolution-api-key-here

# Also available as server-side only (not exposed to client):
# EVOLUTION_API_URL=https://evo.campushub.co.ke
# EVOLUTION_API_KEY=your-evolution-api-key-here

# ─── App / Backend URL ──────────────────────────────────────────────────────
# Points to your Vercel deployment for API calls from the Capacitor app.
# On web this is not needed (relative URLs are used).
NEXT_PUBLIC_API_URL=https://wamorgan.vercel.app
NEXT_PUBLIC_APP_URL=https://wamorgan.vercel.app
