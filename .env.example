# ─── Evolution API Configuration ─────────────────────────────────────────────
# Used for WhatsApp automation via Evolution API
NEXT_PUBLIC_EVOLUTION_URL=https://evolution.histoview.co.ke:8443
NEXT_PUBLIC_EVOLUTION_API_KEY=your-evolution-api-key-here

# Server-side only (not exposed to client)
EVOLUTION_API_URL=https://evolution.histoview.co.ke:8443
EVOLUTION_API_KEY=your-evolution-api-key-here

# ─── App / Backend URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://wamorgan.vercel.app
NEXT_PUBLIC_APP_URL=https://wamorgan.vercel.app

# ─── Firebase Client SDK ────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ─── Firebase Admin SDK (for webhook Firestore access) ──────────────────────
# Required for the webhook to persist conversations and read settings.
# Generate from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── AI Service (Groq) ──────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─── Bunny.net CDN & Storage ───────────────────────────────────────────────
NEXT_PUBLIC_BUNNY_CDN_URL=https://your-storage.b-cdn.net
NEXT_PUBLIC_BUNNY_STORAGE_HOST=your-storage.bunnycdn.com
NEXT_PUBLIC_BUNNY_STORAGE_ZONE=your-zone
BUNNY_API_KEY=your-bunny-api-key
